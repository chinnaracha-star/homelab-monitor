HOMELAB_ENVIRONMENT=development
HOMELAB_DATABASE_URL=sqlite:///./data/homelab-monitor.db
HOMELAB_LOG_LEVEL=INFO
HOMELAB_LOG_DIR=
HOMELAB_REGISTRATION_KEY=replace-with-a-long-random-registration-key
HOMELAB_JWT_SECRET=replace-with-a-long-random-jwt-secret-key
HOMELAB_JWT_EXPIRE_MINUTES=60
HOMELAB_AGENT_REPORT_INTERVAL_SECONDS=60
HOMELAB_MINIMUM_AGENT_VERSION=0.1.0
HOMELAB_LATEST_AGENT_VERSION=0.1.0
# Used as fallback thresholds when no alert_rules rows exist.
HOMELAB_ALERT_CPU_THRESHOLD_PERCENT=90
HOMELAB_ALERT_MEMORY_THRESHOLD_PERCENT=90
HOMELAB_ALERT_DISK_THRESHOLD_PERCENT=90
HOMELAB_ALERT_TEMPERATURE_THRESHOLD_CELSIUS=85
HOMELAB_AGENT_OFFLINE_AFTER_SECONDS=180
HOMELAB_ALERT_EVALUATION_INTERVAL_SECONDS=30

# Telegram Bot API integration is optional.
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT=30
# Set true to resume Telegram delivery.
HOMELAB_TELEGRAM_ENABLED=false

# Optional Discord / Slack / email can also be configured in the dashboard
# Settings page (stored in notification_settings).

# Infrastructure connectors default to mock snapshots (no NAS required).
HOMELAB_INFRASTRUCTURE_MOCK=true
HOMELAB_INFRASTRUCTURE_REFRESH_SECONDS=30
HOMELAB_INFRASTRUCTURE_TIMEOUT_SECONDS=2
HOMELAB_QNAP_URL=
HOMELAB_QNAP_USERNAME=
HOMELAB_QNAP_PASSWORD=
HOMELAB_QNAP_SID=
HOMELAB_DOCKER_URL=
HOMELAB_IMMICH_URL=
HOMELAB_IMMICH_API_KEY=
HOMELAB_QUMAGIE_URL=
HOMELAB_QUMAGIE_API_KEY=
HOMELAB_BACKUP_URL=

# Optional Tailscale status (read-only). Leave defaults; the API never configures Tailscale.
# HOMELAB_TAILSCALE_BIN=tailscale
# HOMELAB_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
# HOMELAB_DASHBOARD_HEALTH_URL=http://127.0.0.1:8080/
